@model List<MyPortfolioProject.Entities.About>
@{
    ViewData["Title"] = "Hakkımda Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Hakkımda Bilgileri</h5>
        <a href="/Admin/About/CreateAbout" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Hakkımda Ekle
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Unvan (Expert)</th>
                    <th>Konum</th>
                    <th>E-posta</th>
                    <th>Çalışma Durumu</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
            
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NameSurname</td>
                            <td>@item.Expert</td>
                            <td>@item.Location</td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.OpenToWork
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/About/UpdateAbout/@item.AboutId" class="btn btn-sm btn-outline-success me-1">
                                    <i class="bi bi-pencil-square"></i> Güncelle
                                </a>
                                <a href="/Admin/About/DeleteAbout/@item.AboutId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
              
            </tbody>
        </table>
    </div>
</div>