@model List<MyPortfolioProject.Entities.Skill>
@{
    ViewData["Title"] = "Yetenekler Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Yetenekler Listesi</h5>
        <a href="/Admin/Skill/CreateSkill" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Yetenek Ekle
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Yetenek / Teknoloji</th>
                    <th>Oran / Değer</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.SkillId</td>
                            <td>@item.Title</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress w-50" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @item.Value%;"></div>
                                    </div>
                                    <span class="small text-muted">@item.Value%</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/Skill/UpdateSkill/@item.SkillId" class="btn btn-sm btn-outline-success me-1">
                                    <i class="bi bi-pencil-square"></i> Güncelle
                                </a>
                                <a href="/Admin/Skill/DeleteSkill/@item.SkillId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu yeteneği silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Henüz kayıtlı bir yetenek bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>