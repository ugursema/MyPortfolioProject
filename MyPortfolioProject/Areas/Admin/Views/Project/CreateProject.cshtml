 

@model MyPortfolioProject.Entities.Project
@{
    ViewData["Title"] = "CreateProject";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<form method="post">
    <div class="container">
        <br />
        <label>Başlık</label>
        <input type="text" asp-for="Title" class="form-control" />
        <br />
        <label>Açıklama</label>
        <input type="text" asp-for="Description" class="form-control" />
        <br />
        <label>Github Adresi</label>
        <input type="text" asp-for="GitHubUrl" class="form-control" />
        <br />
        <label>Proje Görseli (URL)</label>
        <input type="text" asp-for="CoverImageUrl" class="form-control" />
        <br /> 
        <label>Proje Kategorisi</label>
        @Html.DropDownListFor(x => x.CategoryId, (SelectList)ViewBag.v, "Kategori Seçiniz", new { @class = "form-control" })
        <br />
        <button class="btn btn-info">Projeyi Kaydet</button>
    </div>
</form>