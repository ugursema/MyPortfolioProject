@{
    ViewData["Title"] = "ProjectList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@model List<MyPortfolioProject.Entities.Project>

<div class="container-fluid px-4 py-4">
    <!-- Üst Başlık ve Yeni Ekle Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Projeler Listesi</h3>
            <p class="text-muted small mb-0">Portfolyönüzde sergilenen projeleri buradan yönetebilirsiniz.</p>
        </div>
        <a href="/Admin/Project/CreateProject" class="btn btn-primary px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Proje Ekle
        </a>
    </div>

    <!-- Ana Tablo Kartı -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-4">#</th>

                            <th>Proje Başlığı</th>
                            <th>Kategori</th>
                            <th>Açıklama</th>
                            <th>GitHub</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@item.ProjectId</td>

                                    <td class="fw-semibold text-dark">@item.Title</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @(item.Category?.CategoryName ?? "Kategori Yok")
                                        </span>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 200px;" title="@item.Description">
                                        @item.Description
                                    </td>
                                    <td>

                                        <a href="@item.GitHubUrl" target="_blank" class="btn btn-sm btn-outline-dark px-2 py-1">
                                            <i class="bi bi-github"></i> Git
                                        </a>


                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn btn-sm btn-outline-success px-2 py-1 me-1">
                                            <i class="bi bi-pencil-square"></i> Güncelle
                                        </a>
                                        <a href="/Admin/Project/DeleteProject/@item.ProjectId" class="btn btn-sm btn-outline-danger px-2 py-1" onclick="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash"></i> Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        
                         
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>