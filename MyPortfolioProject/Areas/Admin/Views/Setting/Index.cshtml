@model MyPortfolioProject.Entities.Setting
@{
    ViewData["Title"] = "Site ve Profil Ayarları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="mb-4">
        <h5 class="fw-bold mb-1">Site & Profil Ayarları</h5>
        <p class="text-muted small mb-0">İletişim bilgilerinizi, sosyal medya bağlantılarınızı ve giriş bilgilerinizi buradan güncelleyebilirsiniz.</p>
    </div>

    <form method="post" action="/Admin/Setting/Index">
        <input type="hidden" asp-for="SettingId" />

        <div class="row g-4">
            <!-- Sol Kolon: İletişim & Sosyal Medya -->
            <div class="col-lg-6">
                <div class="p-3 border rounded-3 bg-light-subtle h-100">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-globe me-2"></i>İletişim & Sosyal Medya
                    </h6>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Telefon</label>
                        <input type="text" asp-for="Phone" class="form-control" placeholder="+90 5xx xxx xx xx" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">E-posta Adresi</label>
                        <input type="email" asp-for="Email" class="form-control" placeholder="ornek@domain.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Adres / Konum</label>
                        <input type="text" asp-for="Address" class="form-control" placeholder="Şehir, Ülke" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">GitHub Profil URL</label>
                        <input type="url" asp-for="GithubUrl" class="form-control" placeholder="https://github.com/kullaniciadi" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold">LinkedIn Profil URL</label>
                        <input type="url" asp-for="LinkedinUrl" class="form-control" placeholder="https://linkedin.com/in/kullaniciadi" />
                    </div>
                </div>
            </div>

            <!-- Sağ Kolon: Admin Hesap Güvenliği -->
            <div class="col-lg-6">
                <div class="p-3 border rounded-3 bg-light-subtle h-100">
                    <h6 class="fw-bold text-danger mb-3">
                        <i class="bi bi-shield-lock me-2"></i>Admin Giriş Bilgileri
                    </h6>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Kullanıcı Adı</label>
                        <input type="text" asp-for="Username" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Şifre</label>
                        <input type="password" asp-for="Password" class="form-control" required />
                    </div>

                    <div class="alert alert-info small mb-0 mt-4">
                        <i class="bi bi-info-circle me-1"></i> Bu bilgiler admin paneline giriş yaparken kullanacağınız güncel kullanıcı adı ve şifrenizdir.
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>