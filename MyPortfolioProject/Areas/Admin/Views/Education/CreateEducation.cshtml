@model List<MyPortfolioProject.Entities.Education>
@{
    ViewData["Title"] = "Eğitim Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Eğitim Bilgileri Listesi</h5>
        <a href="/Admin/Education/CreateEducation" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Eğitim Ekle
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Okul / Kurs Adı</th>
                    <th>Bölüm / Kategori</th>
                    <th>Tarih / Süre</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.SubTitle</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Duration
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn btn-sm btn-outline-success me-1">
                                    <i class="bi bi-pencil-square"></i> Güncelle
                                </a>
                                <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu eğitimi silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">Henüz kayıtlı bir eğitim bilgisi bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>