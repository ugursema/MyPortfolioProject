@model List<MyPortfolioProject.Entities.Experience>
@{
    ViewData["Title"] = "Deneyim Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0">Deneyimler Listesi</h5>
        <a href="/Admin/Experience/CreateExperience" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Deneyim Ekle
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Başlık</th>
                    <th>Alt Başlık</th>
                    <th>Tarih / Süre</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ExperienceId</td>
                            <td>@item.title</td>
                            <td>@item.SideTitle</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Duration
                                </span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/Admin/Experience/UpdateExperience/@item.ExperienceId" class="btn btn-sm btn-outline-success me-1">
                                    <i class="bi bi-pencil-square"></i> Güncelle
                                </a>
                                <a href="/Admin/Experience/DeleteExperience/@item.ExperienceId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu deneyimi silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i> Sil
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz kayıtlı bir deneyim bilgisi bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>