@model List<MyPortfolioProject.Entities.Contact>

<!-- Contact Section -->
<section id="contact" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">İLETİŞİME GEÇELİM</span>
            <h2 class="section-title">Birlikte Harika İşler Üretebiliriz.</h2>
            <p class="section-subtitle">Yeni projeler, iş birlikleri veya yalnızca merhaba demek için benimle iletişime geçebilirsiniz.</p>
        </div>

        <div class="row g-5">
            <!-- Left: Contact Details -->
            <div class="col-lg-5 reveal-on-scroll">
                @foreach (var item in Model)
                {
                    <div class="contact-info-card">
                        <h4 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h4>
                        <p class="text-secondary mb-4">
                            @item.Description
                        </p>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-purple">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">E-posta</div>
                                <a href="mailto:Sema.UĞUR@example.com" class="text-decoration-none fw-bold text-dark">@item.Email</a>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-blue">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">Konum</div>
                                <div class="fw-bold text-dark">@item.Location</div>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-mint">
                                <i class="bi bi-linkedin"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">LinkedIn</div>
                                <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">@item.Linkedin</a>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-peach">
                                <i class="bi bi-github"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">GitHub</div>
                                <a href="https://github.com" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">@item.Github</a>
                            </div>
                        </div>

                        <div class="mt-4 p-3 rounded-4 bg-white border border-light-subtle">
                            <div class="d-flex align-items-center gap-2 text-secondary small">
                                <i class="bi bi-clock-history text-primary"></i>@item.SubDescription
                            </div>
                        </div>
                    </div>
                }
            </div>

            @await Component.InvokeAsync("_DefaultMessageComponentPartial")
          

        </div>
    </div>
</section>
