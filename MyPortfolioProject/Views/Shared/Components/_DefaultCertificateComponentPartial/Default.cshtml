@model List<MyPortfolioProject.Entities.Certificate>

<!-- Certificates Section -->
<section id="certificates" class="py-5">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">BAŞARILARIM & EĞİTİMLER</span>
            <h2 class="section-title">Sertifikalarım</h2>
            <p class="section-subtitle">Kendimi geliştirmek için tamamladığım kurslar ve sertifikalar.</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 reveal-on-scroll">
                    <div class="certificate-card h-100 d-flex flex-column">
                        <div class="float-icon-box bg-icon-purple mb-3">
                            <i class="bi bi-patch-check"></i>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 mb-2 align-self-start small">@item.Date</span>
                        <h4 class="fs-6 fw-bold mb-1">@item.Title</h4>
                        <div class="text-secondary small mb-3">@item.SubTitle</div>
                        <div class="mt-auto">
                            <a href="@item.CertificateUrl" target="_blank" class="project-link-btn text-primary">
                                Sertifikayı Görüntüle <i class="bi bi-arrow-up-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>